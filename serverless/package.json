{
  "name": "@gramlot/gramlot-serverless",
  "version": "0.3.31",
  "description": "No server: Gramlot pages open from one HTML file or a static directory; the page runs in a Web Worker of the browser.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gramlot-org/gramlot-js-server.git",
    "directory": "serverless"
  },
  "homepage": "https://gramlot-js-server.readthedocs.io/",
  "type": "module",
  "bin": {
    "gramlot-serverless": "./src/cli.js"
  },
  "exports": {
    ".": "./src/build.js",
    "./directory": "./src/build-directory.js",
    "./standalone": "./src/standalone.js",
    "./gramlot-worker-server": "./src/gramlot-worker-server.js"
  },
  "files": [
    "src/build.js",
    "src/build-directory.js",
    "src/bundles.js",
    "src/cli.js",
    "src/gallery.js",
    "README.md",
    "LICENSE",
    "src/standalone.js",
    "src/gramlot-worker-server.js",
    "src/worker-transport.js",
    "src/worker-server-adapter.js",
    "src/runtime-notices.js",
    "src/markdown-bundle.js",
    "NOTICE",
    "gallery",
    "src/collection-bundle.js",
    "src/collection-artifact.js",
    "src/collection-assets.js",
    "src/absent-packages.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout tests/*.test.js"
  },
  "dependencies": {
    "@genrojs/builders": ">=0.6.0",
    "acorn": "^8.19.0",
    "esbuild": "0.28.2",
    "mime-types": "^3.0.2"
  },
  "peerDependencies": {
    "@gramlot/gramlot": ">=0.3.35",
    "@gramlot/gramlot-examples": ">=0.3.26"
  },
  "peerDependenciesMeta": {
    "@gramlot/gramlot-examples": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@genrojs/tytx": ">=0.16.3",
    "@gramlot/gramlot-examples": ">=0.3.26",
    "jsdom": "27.0.1"
  }
}
